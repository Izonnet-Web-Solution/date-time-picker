{
  "name": "@izonnet-web-solution/react-native-date-picker-kit",
  "version": "1.0.0",
  "description": "A modern, customizable, lightweight React Native Date Picker library supporting Android and iOS.",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "lib",
    "src",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf lib",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest",
    "prepare": "npm run build"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "keywords": [
    "react-native",
    "react-native-component",
    "date-picker",
    "calendar",
    "calendar-picker",
    "wheel-date-picker",
    "date-range-picker",
    "date-input",
    "manual-date-entry",
    "date-picker-kit",
    "typescript",
    "ios",
    "android",
    "react-native-date-picker-kit",
    "@izonnet-web-solution/react-native-date-picker-kit"
  ],
  "author": "Izonnet Web Solution",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Izonnet-Web-Solution/react-native-date-picker-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Izonnet-Web-Solution/react-native-date-picker-kit/issues"
  },
  "homepage": "https://github.com/Izonnet-Web-Solution/react-native-date-picker-kit#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.68.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.79",
    "@types/react-native": "^0.73.0",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-builder-bob": "^0.23.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
